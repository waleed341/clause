# Copy to .env. Every setting needs the RAG_ prefix (see app/core/config.py).

# ---------- App ----------
RAG_APP_NAME=Clause
RAG_DATA_PATH=data/shop_handbook.pdf

# ---------- Chat model (LangChain init_chat_model) ----------
# Local and free with Ollama:  ollama pull gemma3:1b
RAG_CHAT_PROVIDER=ollama
RAG_CHAT_MODEL=gemma3:1b
RAG_CHAT_TEMPERATURE=0.1

# Other providers (install the package and export the key in your shell):
#   uv add langchain-anthropic    -> RAG_CHAT_PROVIDER=anthropic     RAG_CHAT_MODEL=<model id>  export ANTHROPIC_API_KEY=...
#   uv add langchain-openai       -> RAG_CHAT_PROVIDER=openai        RAG_CHAT_MODEL=<model id>  export OPENAI_API_KEY=...
#   uv add langchain-google-genai -> RAG_CHAT_PROVIDER=google_genai  RAG_CHAT_MODEL=<model id>  export GOOGLE_API_KEY=...

# ---------- Embeddings ----------
# Local with Ollama:  ollama pull nomic-embed-text
RAG_EMBED_PROVIDER=ollama
RAG_EMBED_MODEL=nomic-embed-text:latest
# Must match the embedding model's output size (nomic-embed-text = 768).
RAG_EMBED_DIM=768

# ---------- Indexing ----------
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# ---------- Retrieval ----------
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.5

# ---------- Qdrant ----------
RAG_COLLECTION_NAME=shop_handbook
RAG_QDRANT_PATH=./qdrant_data

# Optional Qdrant server URL:
# RAG_QDRANT_URL=http://localhost:6333

# ---------- Prompts ----------
RAG_SYSTEM_PROMPT="You are a helpful Clause assistant. Answer only from the provided context. If the answer is not in the context, say you don't know."
